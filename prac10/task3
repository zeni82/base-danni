Поле assignments_and_grades хранит сразу несколько пар «задание  оценка». Это повторяющаяся группа, отдельные задания и оценки нужно вынести в строки, чтобы каждое поле содержало одно значение.

CREATE TABLE StudentGrades (
    student_id INT NOT NULL,
    course_id INT NOT NULL,
    assignment_id INT NOT NULL,
    student_name VARCHAR(255),
    course_professor VARCHAR(255),
    assignment_name VARCHAR(255),
    grade INT,
    PRIMARY KEY (student_id, course_id, assignment_id)
);


 Функциональная зависимость / Тип зависимости /
 student_id - student_name / частичная /
 course_id - course_professor / частичная /
 (course_id, assignment_id) - assignment_name / частичная /
 (student_id, course_id, assignment_id) - grade / полная /


CREATE TABLE Students (
    student_id INT PRIMARY KEY,
    student_name VARCHAR(255)
);

CREATE TABLE Courses (
    course_id INT PRIMARY KEY,
    course_professor VARCHAR(255)
);

CREATE TABLE Assignments (
    course_id INT NOT NULL,
    assignment_id INT NOT NULL,
    assignment_name VARCHAR(255),
    PRIMARY KEY (course_id, assignment_id),
    FOREIGN KEY (course_id)
        REFERENCES Courses(course_id)
);

CREATE TABLE StudentGrades (
    student_id INT NOT NULL,
    course_id INT NOT NULL,
    assignment_id INT NOT NULL,
    grade INT,
    PRIMARY KEY (student_id, course_id, assignment_id),
    FOREIGN KEY (student_id)
        REFERENCES Students(student_id),
    FOREIGN KEY (course_id, assignment_id)
        REFERENCES Assignments(course_id, assignment_id)
);